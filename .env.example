# Postgres URL for `wgate migrate` (as the owner role). Direct to Postgres (5432), not
# through pgbouncer: its transaction pooling breaks the agent's LISTEN. The Makefile
# sources this file with the shell: single-quote values that contain `$` or spaces.
WGATE_DATABASE_URL='postgres://wgate:secret@172.19.9.2:5432/wgate'
# Agent config file for `wgate agent` (default /etc/wgate/agent.toml; example:
# crates/agent/agent.example.toml).
WGATE_AGENT_CONFIG=/etc/wgate/agent.toml
