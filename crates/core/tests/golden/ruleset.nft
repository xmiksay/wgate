add table inet wgate
add set inet wgate tenant_space { type ipv4_addr; flags interval; }
add set inet wgate wg_ifaces { type ifname; }
add map inet wgate ingress { type ifname : verdict; }
add map inet wgate from_net { type ifname : verdict; }
add map inet wgate to_net { type ifname : verdict; }
add chain inet wgate prerouting { type filter hook prerouting priority raw; policy accept; }
add chain inet wgate input { type filter hook input priority filter - 5; policy accept; }
add chain inet wgate forward { type filter hook forward priority filter - 5; policy accept; }
add chain inet wgate output { type filter hook output priority filter - 5; policy accept; }
add chain inet wgate postrouting { type nat hook postrouting priority srcnat; policy accept; }
flush set inet wgate tenant_space
add element inet wgate tenant_space {
	10.50.0.0-10.50.255.255,
	192.168.10.0-192.168.10.255
}
flush chain inet wgate prerouting
add rule inet wgate prerouting iifname != "wg-*" iifname != "lo" ip saddr @tenant_space counter drop
add rule inet wgate prerouting iifname "wg-*" iifname != @wg_ifaces counter drop
add rule inet wgate prerouting iifname "wg-*" iifname != @ingress counter drop
add rule inet wgate prerouting iifname vmap @ingress
flush chain inet wgate input
add rule inet wgate input iifname "wg-*" iifname != @from_net counter drop
add rule inet wgate input iifname vmap @from_net
flush chain inet wgate forward
add rule inet wgate forward oifname "wg-*" oifname != @wg_ifaces counter drop
add rule inet wgate forward iifname "wg-*" iifname != @from_net counter drop
add rule inet wgate forward oifname "wg-*" oifname != @to_net counter drop
add rule inet wgate forward iifname vmap @from_net
add rule inet wgate forward oifname vmap @to_net
flush chain inet wgate output
add rule inet wgate output ip saddr @tenant_space fib saddr type != local counter drop
add rule inet wgate output oifname "wg-*" oifname != @wg_ifaces counter drop
add rule inet wgate output oifname "wg-*" oifname != @to_net counter drop
add rule inet wgate output oifname "wg-*" ct state related icmp type { destination-unreachable, time-exceeded, parameter-problem } accept
add rule inet wgate output oifname vmap @to_net
flush chain inet wgate postrouting
add rule inet wgate postrouting ip saddr @tenant_space ip daddr { 172.19.9.0/24 } snat ip to 172.19.9.10

add table inet wgate
add set inet wgate n1_peers { type ipv4_addr; flags interval; }
add set inet wgate n1_allow { type ipv4_addr . ipv4_addr . inet_proto . inet_service; flags interval; }
add set inet wgate n1_allow_icmp { type ipv4_addr . ipv4_addr; flags interval; }
add set inet wgate n1_inbound { type ipv4_addr . ipv4_addr . inet_proto . inet_service; flags interval; }
add set inet wgate n1_inbound_icmp { type ipv4_addr . ipv4_addr; flags interval; }
add chain inet wgate n1_ingress
add chain inet wgate n1_from
add chain inet wgate n1_to
flush set inet wgate n1_peers
add element inet wgate n1_peers {
	10.50.0.2,
	10.50.0.3,
	192.168.10.0-192.168.10.255
}
flush set inet wgate n1_allow
add element inet wgate n1_allow {
	10.50.0.2 . 10.0.0.0-10.49.255.255 . tcp . 80-90,
	10.50.0.2 . 10.50.1.2-10.50.1.3 . tcp . 22,
	10.50.0.2 . 10.51.0.0-10.255.255.255 . tcp . 80-90,
	10.50.0.2 . 172.16.16.1 . tcp . 6443,
	10.50.0.3 . 10.0.0.0-10.49.255.255 . tcp . 80-90,
	10.50.0.3 . 10.50.1.2-10.50.1.3 . tcp . 22,
	10.50.0.3 . 10.51.0.0-10.255.255.255 . tcp . 80-90,
	10.50.0.3 . 172.16.16.1 . tcp . 6443,
	192.168.10.0-192.168.10.255 . 10.0.0.0-10.49.255.255 . tcp . 80-90,
	192.168.10.0-192.168.10.255 . 10.50.1.2-10.50.1.3 . tcp . 22,
	192.168.10.0-192.168.10.255 . 10.51.0.0-10.255.255.255 . tcp . 80-90,
	192.168.10.0-192.168.10.255 . 172.16.16.1 . tcp . 6443
}
flush set inet wgate n1_allow_icmp
add element inet wgate n1_allow_icmp {
	10.50.0.2 . 172.19.9.10-172.19.9.12,
	10.50.0.3 . 172.19.9.10-172.19.9.12,
	192.168.10.0-192.168.10.255 . 172.19.9.10-172.19.9.12
}
flush set inet wgate n1_inbound
flush set inet wgate n1_inbound_icmp
flush chain inet wgate n1_ingress
add rule inet wgate n1_ingress ip saddr != @n1_peers counter drop
flush chain inet wgate n1_from
add rule inet wgate n1_from ct direction original ip saddr . ip daddr . meta l4proto . th dport @n1_allow return
add rule inet wgate n1_from ct direction original meta l4proto icmp ip saddr . ip daddr @n1_allow_icmp return
add rule inet wgate n1_from ct direction reply ip daddr . ip saddr . meta l4proto . th sport @n1_inbound return
add rule inet wgate n1_from ct direction reply meta l4proto icmp ip daddr . ip saddr @n1_inbound_icmp return
add rule inet wgate n1_from counter drop
flush chain inet wgate n1_to
add rule inet wgate n1_to ct direction original ip saddr . ip daddr . meta l4proto . th dport @n1_inbound return
add rule inet wgate n1_to ct direction original meta l4proto icmp ip saddr . ip daddr @n1_inbound_icmp return
add rule inet wgate n1_to ct direction reply ip daddr . ip saddr . meta l4proto . th sport @n1_allow return
add rule inet wgate n1_to ct direction reply meta l4proto icmp ip daddr . ip saddr @n1_allow_icmp return
add rule inet wgate n1_to counter drop
add element inet wgate wg_ifaces { "wg-nexial" }
add element inet wgate ingress { "wg-nexial" : jump n1_ingress }
add element inet wgate from_net { "wg-nexial" : jump n1_from }
add element inet wgate to_net { "wg-nexial" : jump n1_to }

add table inet wgate
add set inet wgate n2_peers { type ipv4_addr; flags interval; }
add set inet wgate n2_allow { type ipv4_addr . ipv4_addr . inet_proto . inet_service; flags interval; }
add set inet wgate n2_allow_icmp { type ipv4_addr . ipv4_addr; flags interval; }
add set inet wgate n2_inbound { type ipv4_addr . ipv4_addr . inet_proto . inet_service; flags interval; }
add set inet wgate n2_inbound_icmp { type ipv4_addr . ipv4_addr; flags interval; }
add chain inet wgate n2_ingress
add chain inet wgate n2_from
add chain inet wgate n2_to
flush set inet wgate n2_peers
add element inet wgate n2_peers {
	10.50.1.2,
	10.50.1.3
}
flush set inet wgate n2_allow
add element inet wgate n2_allow {
	10.50.1.2 . 10.50.1.3 . tcp . 1-65535,
	10.50.1.2 . 172.16.16.1 . tcp . 6443,
	10.50.1.2 . 10.50.1.3 . udp . 1-65535,
	10.50.1.3 . 10.50.1.2 . tcp . 1-65535,
	10.50.1.3 . 172.16.16.1 . tcp . 6443,
	10.50.1.3 . 10.50.1.2 . udp . 1-65535
}
flush set inet wgate n2_allow_icmp
add element inet wgate n2_allow_icmp {
	10.50.1.2 . 10.50.1.3,
	10.50.1.3 . 10.50.1.2
}
flush set inet wgate n2_inbound
add element inet wgate n2_inbound {
	10.50.0.2-10.50.0.3 . 10.50.1.2 . tcp . 22,
	10.50.1.3 . 10.50.1.2 . tcp . 1-65535,
	10.50.2.2 . 10.50.1.2 . tcp . 443,
	10.244.0.0-10.244.255.255 . 10.50.1.2 . tcp . 8080,
	192.168.10.0-192.168.10.255 . 10.50.1.2 . tcp . 22,
	10.50.1.3 . 10.50.1.2 . udp . 1-65535,
	10.50.0.2-10.50.0.3 . 10.50.1.3 . tcp . 22,
	10.50.1.2 . 10.50.1.3 . tcp . 1-65535,
	10.50.2.2 . 10.50.1.3 . tcp . 443,
	10.244.0.0-10.244.255.255 . 10.50.1.3 . tcp . 8080,
	192.168.10.0-192.168.10.255 . 10.50.1.3 . tcp . 22,
	10.50.1.2 . 10.50.1.3 . udp . 1-65535
}
flush set inet wgate n2_inbound_icmp
add element inet wgate n2_inbound_icmp {
	10.50.1.3 . 10.50.1.2,
	10.50.1.2 . 10.50.1.3
}
flush chain inet wgate n2_ingress
add rule inet wgate n2_ingress ip saddr != @n2_peers counter drop
flush chain inet wgate n2_from
add rule inet wgate n2_from ct direction original ip saddr . ip daddr . meta l4proto . th dport @n2_allow return
add rule inet wgate n2_from ct direction original meta l4proto icmp ip saddr . ip daddr @n2_allow_icmp return
add rule inet wgate n2_from ct direction reply ip daddr . ip saddr . meta l4proto . th sport @n2_inbound return
add rule inet wgate n2_from ct direction reply meta l4proto icmp ip daddr . ip saddr @n2_inbound_icmp return
add rule inet wgate n2_from counter drop
flush chain inet wgate n2_to
add rule inet wgate n2_to ct direction original ip saddr . ip daddr . meta l4proto . th dport @n2_inbound return
add rule inet wgate n2_to ct direction original meta l4proto icmp ip saddr . ip daddr @n2_inbound_icmp return
add rule inet wgate n2_to ct direction reply ip daddr . ip saddr . meta l4proto . th sport @n2_allow return
add rule inet wgate n2_to ct direction reply meta l4proto icmp ip daddr . ip saddr @n2_allow_icmp return
add rule inet wgate n2_to counter drop
add element inet wgate wg_ifaces { "wg-nexial-dev" }
add element inet wgate ingress { "wg-nexial-dev" : jump n2_ingress }
add element inet wgate from_net { "wg-nexial-dev" : jump n2_from }
add element inet wgate to_net { "wg-nexial-dev" : jump n2_to }

add table inet wgate
add set inet wgate n3_peers { type ipv4_addr; flags interval; }
add set inet wgate n3_allow { type ipv4_addr . ipv4_addr . inet_proto . inet_service; flags interval; }
add set inet wgate n3_allow_icmp { type ipv4_addr . ipv4_addr; flags interval; }
add set inet wgate n3_inbound { type ipv4_addr . ipv4_addr . inet_proto . inet_service; flags interval; }
add set inet wgate n3_inbound_icmp { type ipv4_addr . ipv4_addr; flags interval; }
add chain inet wgate n3_ingress
add chain inet wgate n3_from
add chain inet wgate n3_to
flush set inet wgate n3_peers
add element inet wgate n3_peers {
	10.50.2.2
}
flush set inet wgate n3_allow
add element inet wgate n3_allow {
	10.50.2.2 . 10.50.1.2-10.50.1.3 . tcp . 443,
	10.50.2.2 . 172.16.16.1 . tcp . 6443
}
flush set inet wgate n3_allow_icmp
flush set inet wgate n3_inbound
flush set inet wgate n3_inbound_icmp
flush chain inet wgate n3_ingress
add rule inet wgate n3_ingress ip saddr != @n3_peers counter drop
flush chain inet wgate n3_from
add rule inet wgate n3_from ct direction original ip saddr . ip daddr . meta l4proto . th dport @n3_allow return
add rule inet wgate n3_from ct direction original meta l4proto icmp ip saddr . ip daddr @n3_allow_icmp return
add rule inet wgate n3_from ct direction reply ip daddr . ip saddr . meta l4proto . th sport @n3_inbound return
add rule inet wgate n3_from ct direction reply meta l4proto icmp ip daddr . ip saddr @n3_inbound_icmp return
add rule inet wgate n3_from counter drop
flush chain inet wgate n3_to
add rule inet wgate n3_to ct direction original ip saddr . ip daddr . meta l4proto . th dport @n3_inbound return
add rule inet wgate n3_to ct direction original meta l4proto icmp ip saddr . ip daddr @n3_inbound_icmp return
add rule inet wgate n3_to ct direction reply ip daddr . ip saddr . meta l4proto . th sport @n3_allow return
add rule inet wgate n3_to ct direction reply meta l4proto icmp ip daddr . ip saddr @n3_allow_icmp return
add rule inet wgate n3_to counter drop
add element inet wgate wg_ifaces { "wg-krcmar" }
add element inet wgate ingress { "wg-krcmar" : jump n3_ingress }
add element inet wgate from_net { "wg-krcmar" : jump n3_from }
add element inet wgate to_net { "wg-krcmar" : jump n3_to }
