table inet wgate {}
delete table inet wgate

table inet wgate {
	set allow {
		type ipv4_addr . ipv4_addr . inet_proto . inet_service
		flags interval
		elements = {
			10.50.1.2 . 10.0.0.0-10.0.255.255 . tcp . 80-90,
			10.50.1.2 . 10.1.0.0-10.1.255.255 . tcp . 80-100,
			10.50.1.2 . 10.2.0.0-10.255.255.255 . tcp . 80-90,
			10.50.1.2 . 172.16.16.1 . tcp . 6443,
			10.50.1.2 . 172.19.9.0-172.19.9.255 . udp . 53,
			10.50.2.2 . 172.16.16.1 . tcp . 6443
		}
	}

	set allow_icmp {
		type ipv4_addr . ipv4_addr
		flags interval
		elements = {
			10.50.1.2 . 172.19.9.10-172.19.9.12
		}
	}

	chain tenant {
		ip daddr 10.50.0.0/16 counter drop
		ct state related meta l4proto icmp accept
		ip saddr . ip daddr . meta l4proto . th dport @allow accept
		meta l4proto icmp ip saddr . ip daddr @allow_icmp accept
		counter drop
	}

	chain tenant_reply {
		ip daddr . ip saddr . meta l4proto . th sport @allow accept
		meta l4proto icmp ip daddr . ip saddr @allow_icmp accept
		ct state related meta l4proto icmp accept
		counter drop
	}

	chain input {
		type filter hook input priority filter - 5; policy accept;
		iifname "wg-*" ct direction reply ct state established accept
		iifname "wg-*" jump tenant
	}

	chain forward {
		type filter hook forward priority filter - 5; policy accept;
		iifname "wg-*" oifname "wg0" ct direction reply ct state established accept
		iifname "wg-*" jump tenant
		oifname "wg-*" iifname "wg0" ct direction original accept
		oifname "wg-*" ct direction reply ct state established,related jump tenant_reply
		oifname "wg-*" drop
	}

	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		ip saddr 10.50.0.0/16 ip daddr { 172.19.9.0/24 } snat ip to 172.19.9.10
	}
}
