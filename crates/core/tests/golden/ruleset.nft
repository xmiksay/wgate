table inet wgate {}
delete table inet wgate

table inet wgate {
	set tenant_space {
		type ipv4_addr
		flags interval
		elements = {
			10.50.0.0-10.50.255.255,
			192.168.10.0-192.168.10.255
		}
	}

	set ingress {
		type ifname . ipv4_addr
		flags interval
		elements = {
			"wg-nexial" . 10.50.0.2,
			"wg-nexial" . 10.50.0.3,
			"wg-nexial" . 192.168.10.0-192.168.10.255,
			"wg-nexial-dev" . 10.50.1.2,
			"wg-nexial-dev" . 10.50.1.3,
			"wg-krcmar" . 10.50.2.2
		}
	}

	set peer_addrs {
		type ipv4_addr
		flags interval
		elements = {
			10.50.0.2,
			10.50.0.3,
			192.168.10.0-192.168.10.255,
			10.50.1.2,
			10.50.1.3,
			10.50.2.2
		}
	}

	set allow {
		type ipv4_addr . ipv4_addr . inet_proto . inet_service
		flags interval
		elements = {
			10.50.0.2 . 10.0.0.0-10.49.255.255 . tcp . 80-90,
			10.50.0.2 . 10.50.1.2-10.50.1.3 . tcp . 22,
			10.50.0.2 . 10.51.0.0-10.255.255.255 . tcp . 80-90,
			10.50.0.2 . 172.16.16.1 . tcp . 6443,
			10.50.0.3 . 10.0.0.0-10.49.255.255 . tcp . 80-90,
			10.50.0.3 . 10.50.1.2-10.50.1.3 . tcp . 22,
			10.50.0.3 . 10.51.0.0-10.255.255.255 . tcp . 80-90,
			10.50.0.3 . 172.16.16.1 . tcp . 6443,
			192.168.10.0-192.168.10.255 . 10.0.0.0-10.49.255.255 . tcp . 80-90,
			192.168.10.0-192.168.10.255 . 10.50.1.2-10.50.1.3 . tcp . 22,
			192.168.10.0-192.168.10.255 . 10.51.0.0-10.255.255.255 . tcp . 80-90,
			192.168.10.0-192.168.10.255 . 172.16.16.1 . tcp . 6443,
			10.50.1.2 . 10.50.1.3 . tcp . 1-65535,
			10.50.1.2 . 172.16.16.1 . tcp . 6443,
			10.50.1.2 . 10.50.1.3 . udp . 1-65535,
			10.50.1.3 . 10.50.1.2 . tcp . 1-65535,
			10.50.1.3 . 172.16.16.1 . tcp . 6443,
			10.50.1.3 . 10.50.1.2 . udp . 1-65535,
			10.50.2.2 . 10.50.1.2-10.50.1.3 . tcp . 443,
			10.50.2.2 . 172.16.16.1 . tcp . 6443
		}
	}

	set allow_icmp {
		type ipv4_addr . ipv4_addr
		flags interval
		elements = {
			10.50.0.2 . 172.19.9.10-172.19.9.12,
			10.50.0.3 . 172.19.9.10-172.19.9.12,
			192.168.10.0-192.168.10.255 . 172.19.9.10-172.19.9.12,
			10.50.1.2 . 10.50.1.3,
			10.50.1.3 . 10.50.1.2
		}
	}

	set inbound {
		type ipv4_addr . ipv4_addr . inet_proto . inet_service
		flags interval
		elements = {
			10.50.0.2-10.50.0.3 . 10.50.1.2 . tcp . 22,
			10.50.1.3 . 10.50.1.2 . tcp . 1-65535,
			10.50.2.2 . 10.50.1.2 . tcp . 443,
			10.244.0.0-10.244.255.255 . 10.50.1.2 . tcp . 8080,
			192.168.10.0-192.168.10.255 . 10.50.1.2 . tcp . 22,
			10.50.1.3 . 10.50.1.2 . udp . 1-65535,
			10.50.0.2-10.50.0.3 . 10.50.1.3 . tcp . 22,
			10.50.1.2 . 10.50.1.3 . tcp . 1-65535,
			10.50.2.2 . 10.50.1.3 . tcp . 443,
			10.244.0.0-10.244.255.255 . 10.50.1.3 . tcp . 8080,
			192.168.10.0-192.168.10.255 . 10.50.1.3 . tcp . 22,
			10.50.1.2 . 10.50.1.3 . udp . 1-65535
		}
	}

	set inbound_icmp {
		type ipv4_addr . ipv4_addr
		flags interval
		elements = {
			10.50.1.3 . 10.50.1.2,
			10.50.1.2 . 10.50.1.3
		}
	}

	chain prerouting {
		type filter hook prerouting priority raw; policy accept;
		iifname != "wg-*" iifname != "lo" ip saddr @tenant_space counter drop
		iifname "wg-*" iifname . ip saddr != @ingress counter drop
	}

	chain from_tenant {
		ip daddr @peer_addrs jump tenant_to_tenant
		ip saddr . ip daddr . meta l4proto . th dport @allow accept
		meta l4proto icmp ip saddr . ip daddr @allow_icmp accept
		counter drop
	}

	chain tenant_to_tenant {
		ip saddr . ip daddr . meta l4proto . th dport @allow ip saddr . ip daddr . meta l4proto . th dport @inbound accept
		meta l4proto icmp ip saddr . ip daddr @allow_icmp ip saddr . ip daddr @inbound_icmp accept
		counter drop
	}

	chain tenant_answers {
		ip daddr @peer_addrs jump tenant_answers_tenant
		ip daddr . ip saddr . meta l4proto . th sport @inbound accept
		meta l4proto icmp ip daddr . ip saddr @inbound_icmp accept
		counter drop
	}

	chain tenant_answers_tenant {
		ip daddr . ip saddr . meta l4proto . th sport @allow ip daddr . ip saddr . meta l4proto . th sport @inbound accept
		meta l4proto icmp ip daddr . ip saddr @allow_icmp ip daddr . ip saddr @inbound_icmp accept
		counter drop
	}

	chain to_tenant {
		ip saddr . ip daddr . meta l4proto . th dport @inbound accept
		meta l4proto icmp ip saddr . ip daddr @inbound_icmp accept
		counter drop
	}

	chain to_tenant_reply {
		ip daddr . ip saddr . meta l4proto . th sport @allow accept
		meta l4proto icmp ip daddr . ip saddr @allow_icmp accept
		counter drop
	}

	chain input {
		type filter hook input priority filter - 5; policy accept;
		iifname "wg-*" ct direction original jump from_tenant
		iifname "wg-*" ct direction reply jump tenant_answers
		iifname "wg-*" counter drop
	}

	chain output {
		type filter hook output priority filter - 5; policy accept;
		ip saddr @peer_addrs counter drop
		oifname "wg-*" ct state related icmp type { destination-unreachable, time-exceeded, parameter-problem } accept
		oifname "wg-*" ct direction original jump to_tenant
		oifname "wg-*" ct direction reply jump to_tenant_reply
		oifname "wg-*" counter drop
	}

	chain forward {
		type filter hook forward priority filter - 5; policy accept;
		iifname "wg-*" ct direction original jump from_tenant
		iifname "wg-*" ct direction reply jump tenant_answers
		iifname "wg-*" counter drop
		oifname "wg-*" ct direction original jump to_tenant
		oifname "wg-*" ct direction reply jump to_tenant_reply
		oifname "wg-*" counter drop
	}

	chain postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		ip saddr @peer_addrs ip daddr { 172.19.9.0/24 } snat ip to 172.19.9.10
	}
}
